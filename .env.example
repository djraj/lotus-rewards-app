# Copy to `.env` and fill in. `.env` is git-ignored.

# --- App (build-time, shipped to the client) ---
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-project-anon-key>

# --- Supabase CLI only (never shipped) ---
DATABASE_PASS=<your-project-db-password>

# --- Brevo SMTP, read by `supabase start` for auth email (see Docs/email-setup.md) ---
BREVO_SMTP_USER=<your-brevo-account-email>
BREVO_SMTP_KEY=<your-brevo-smtp-key>
EMAIL_SENDER_ADDRESS=<a-verified-brevo-sender-address>

# The `notify` Edge Function's own secrets are set with `supabase secrets set`,
# not here (or in supabase/functions/.env for `functions serve`):
#   WEBHOOK_SECRET, BREVO_API_KEY, EMAIL_SENDER_ADDRESS, EMAIL_SENDER_NAME, APP_URL
